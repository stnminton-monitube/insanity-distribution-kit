{
  "name": "insanity-distribution-kit",
  "productName": "Insanity Distribution Kit",
  "version": "2.1.0",
  "author": "Insanity Media",
  "description": "Platform-specific streaming delivery QC, metadata, captions, artwork, compliance and filing",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "test": "node test/verify.js"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "tesseract.js": "^5.1.1"
  },
  "build": {
    "appId": "com.insanity.distributionkit",
    "icon": "assets/icon.png",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": "dmg",
      "category": "public.app-category.video"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "ffmpeg-static@5.3.0": true,
    "tesseract.js@5.1.1": true
  }
}
